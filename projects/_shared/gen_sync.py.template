import io, json, re, shutil, subprocess, sys, unicodedata
from pathlib import Path

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8")

HERE = Path(__file__).resolve().parent
FPS = 30
LEAD = 8
SLUG = "CHANGEME"  # ten thu muc trong remotion-composer/public/

SPEC = {
    # "BEAT_NAME": [("key", "tu_neo"), ...]  -- neo theo TOKEN WHISPER GHI, khong theo chu trong script
}


def norm(s):
    s = unicodedata.normalize("NFD", s.lower())
    s = "".join(c for c in s if unicodedata.category(c) != "Mn")
    s = s.replace("đ", "d")
    return re.sub(r"[^a-z0-9]", "", s)


def probe(p):
    out = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(p)],
                         capture_output=True, text=True, check=True)
    return float(out.stdout.strip())


def sync_voice(total):
    src = HERE / "tts" / "voice_full.mp3"
    dst = HERE / ".." / ".." / "remotion-composer" / "public" / SLUG / "voice.mp3"
    dst.parent.mkdir(parents=True, exist_ok=True)
    stale = (not dst.exists()) or dst.read_bytes() != src.read_bytes()
    if stale:
        shutil.copy(src, dst)
    d = probe(dst)
    if abs(d - total) > 0.05:
        raise SystemExit(f"FATAL: voice.mp3 {d:.3f}s != beats total {total:.3f}s")
    print(f"voice.mp3 {'COPIED (da cu -> da dong bo)' if stale else 'khop san'} — {d:.3f}s")


def main():
    words = json.loads((HERE / "whisper_words.json").read_text(encoding="utf-8"))
    segs = json.loads((HERE / "segments.json").read_text(encoding="utf-8"))["segments"]
    smap = {s["name"]: s for s in segs}

    out, problems = {}, []
    for bname, anchors in SPEC.items():
        s = smap[bname]
        bs, cd, bd = s["start"], s["content_dur"], s["duration"]
        pool = [w for w in words if bs <= w["t"] < bs + cd]
        cursor = -1
        entries = {}
        for key, anc in anchors:
            toks = anc.split()
            hit = None
            for pos in range(cursor + 1, len(pool) - len(toks) + 1):
                if all(norm(toks[k]) in norm(pool[pos + k]["w"]) for k in range(len(toks))):
                    hit = (pos, pool[pos])
                    break
            if hit is None:
                problems.append(f"MISS  {bname}.{key} <- '{anc}'")
                entries[key] = 0
                continue
            cursor = hit[0]
            e = max(0, round((hit[1]["t"] - bs) * FPS) - LEAD)
            cap = round(bd * FPS) - 6
            if e >= cap:
                problems.append(f"OVER  {bname}.{key} e={e} cap={cap}")
                e = max(0, cap - 1)
            entries[key] = e
        out[bname] = entries

    (HERE / "timings.json").write_text(json.dumps(out, ensure_ascii=False, indent=1), encoding="utf-8")
    shutil.copy(HERE / "timings.json", HERE / ".." / ".." / "remotion-composer" / "src" / f"{SLUG}_timings.json")

    beats = {"beats": [{"index": s["index"], "name": s["name"], "start": s["start"], "duration": s["duration"]} for s in segs],
             "total_duration": round(sum(s["duration"] for s in segs), 3)}
    (HERE / "beats.json").write_text(json.dumps(beats, ensure_ascii=False, indent=1), encoding="utf-8")
    shutil.copy(HERE / "beats.json", HERE / ".." / ".." / "remotion-composer" / "src" / f"{SLUG}_beats.json")

    sync_voice(beats["total_duration"])

    for bname in SPEC:
        s = smap[bname]
        row = "  ".join(f"{k}={v}" for k, v in out[bname].items())
        print(f"{bname:<10} start={s['start']:7.2f} dur={s['duration']:5.2f}  {row}")
    print()
    print("total_duration:", beats["total_duration"], "-> frames:", round(beats["total_duration"] * FPS))
    if problems:
        print("VAN DE:")
        for p in problems:
            print("  ", p)
    else:
        print("ALL ANCHORS HIT")


if __name__ == "__main__":
    main()
